# The target the bundled third-party libraries (FFmpeg, libvpx; cmake/ffmpeg.cmake, cmake/libvpx.cmake) are built for:
# their own configure scripts get the engine's compiler, processor, system and flags.
#
#   BO1_DEP_ARCH     FFmpeg's --arch: aarch64, x86_64, x86, arm
#   BO1_DEP_OS       FFmpeg's --target-os: darwin, linux, mingw32
#   BO1_DEP_CFLAGS   compiler flags selecting the target (-target / -arch, sysroot, minimum OS)
#   BO1_DEP_LDFLAGS  the same for linking
#   BO1_DEP_CROSS    the target is not the build machine (FFmpeg's --enable-cross-compile)

include_guard(GLOBAL)

# processor: macOS builds name it in CMAKE_OSX_ARCHITECTURES (one architecture per build), the others in
# CMAKE_SYSTEM_PROCESSOR
if(APPLE)
    set(_bo1_proc "${CMAKE_OSX_ARCHITECTURES}")
else()
    set(_bo1_proc "${CMAKE_SYSTEM_PROCESSOR}")
endif()
string(TOLOWER "${_bo1_proc}" _bo1_proc)
if(_bo1_proc MATCHES "^(arm64|aarch64)$")
    set(BO1_DEP_ARCH aarch64)
elseif(_bo1_proc MATCHES "^(x86_64|amd64|x64)$")
    set(BO1_DEP_ARCH x86_64)
elseif(_bo1_proc MATCHES "^(i[3-6]86|x86)$")
    set(BO1_DEP_ARCH x86)
elseif(_bo1_proc MATCHES "^(arm|armv7|armv7l|armv7-a|armhf)$")
    set(BO1_DEP_ARCH arm)
else()
    message(FATAL_ERROR "Unsupported processor '${_bo1_proc}' (arm64, x86_64, x86 or arm)")
endif()

if(APPLE)
    set(BO1_DEP_OS darwin)
elseif(WIN32)
    set(BO1_DEP_OS mingw32)
else()
    set(BO1_DEP_OS linux)
endif()

# a different processor than the build machine's is a cross build too (an x86_64 Mac build on an Apple silicon Mac)
string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _bo1_host)
if(_bo1_host STREQUAL "arm64")
    set(_bo1_host aarch64)
elseif(_bo1_host STREQUAL "amd64")
    set(_bo1_host x86_64)
endif()
if(CMAKE_CROSSCOMPILING OR NOT _bo1_host STREQUAL BO1_DEP_ARCH)
    set(BO1_DEP_CROSS TRUE)
else()
    set(BO1_DEP_CROSS FALSE)
endif()

set(BO1_DEP_CFLAGS "")
set(BO1_DEP_LDFLAGS "")
if(APPLE)
    if(CMAKE_OSX_SYSROOT)
        set(_bo1_sysroot "${CMAKE_OSX_SYSROOT}")
    elseif(MACOS_SDK)
        set(_bo1_sysroot "${MACOS_SDK}")
    endif()
    if(CMAKE_CROSSCOMPILING)
        # clang driving ld64.lld from a non-Apple host (cmake/toolchain-macos.cmake)
        set(BO1_DEP_CFLAGS "-target ${CMAKE_OSX_ARCHITECTURES}-apple-macos${CMAKE_OSX_DEPLOYMENT_TARGET} -isysroot ${_bo1_sysroot}")
        set(BO1_DEP_LDFLAGS "${BO1_DEP_CFLAGS} -fuse-ld=lld")
    else()
        set(BO1_DEP_CFLAGS "-arch ${CMAKE_OSX_ARCHITECTURES} -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        if(_bo1_sysroot)
            string(APPEND BO1_DEP_CFLAGS " -isysroot ${_bo1_sysroot}")
        endif()
        set(BO1_DEP_LDFLAGS "${BO1_DEP_CFLAGS}")
    endif()
elseif(CMAKE_C_COMPILER_TARGET)
    # a clang cross build (cmake/toolchain-linux.cmake, cmake/toolchain-mingw.cmake)
    set(BO1_DEP_CFLAGS "--target=${CMAKE_C_COMPILER_TARGET}")
    if(CMAKE_SYSROOT)
        string(APPEND BO1_DEP_CFLAGS " --sysroot=${CMAKE_SYSROOT}")
    endif()
    if(BO1_TARGET_CFLAGS)
        string(APPEND BO1_DEP_CFLAGS " ${BO1_TARGET_CFLAGS}")
    endif()
    set(BO1_DEP_LDFLAGS "${BO1_DEP_CFLAGS} ${CMAKE_EXE_LINKER_FLAGS_INIT}")
elseif(BO1_TARGET_CFLAGS)
    set(BO1_DEP_CFLAGS "${BO1_TARGET_CFLAGS}")
    set(BO1_DEP_LDFLAGS "${BO1_TARGET_CFLAGS}")
endif()
